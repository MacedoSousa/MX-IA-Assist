MX_NAME=Macedxs AI

ENVIRONMENT=development

TZ=America/Sao_Paulo

# MX Database

POSTGRES_DB=mx

POSTGRES_USER=mx

POSTGRES_PASSWORD=CHANGE_ME

# Local Ollama profile. Keep qwen3:8b for speed; use deepseek-r1:14b for
# heavier reasoning after pulling it into the persistent Ollama volume.
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=gemma4:e4b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MEM_LIMIT=12g
OLLAMA_MEM_RESERVATION=6g
OLLAMA_CPUS=8.0
