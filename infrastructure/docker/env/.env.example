MX_NAME=Macedxs AI

ENVIRONMENT=development

TZ=America/Sao_Paulo

# MX Database

POSTGRES_DB=mx

POSTGRES_USER=mx

POSTGRES_PASSWORD=CHANGE_ME

# Quality-first local Ollama profile. DeepSeek R1 14B is the strongest
# installed text-reasoning model for the current RTX 2060 Super + 32 GB RAM.
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_VISION_MODEL=gemma4:e4b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=1h
OLLAMA_FAST_CASUAL=true
OLLAMA_WARMUP_ENABLED=true
OLLAMA_CONTEXT_LENGTH=8192

# DeepSeek Harness developer preview (local-only, no public bind by default).
DSH_VERSION=0.1.0-rc.8
MX_DSH_BIND=127.0.0.1
MX_DSH_PORT=3080
